# Database connection string (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# 64-character high-entropy secret for signing JWT session tokens (generate using: openssl rand -hex 32)
JWT_SECRET="generate_64_char_cryptographically_secure_random_hex_secret_here"

# Seed synchronization secret
SEED_SECRET="replace_with_strong_seed_secret"

# Public App URL for CORS and redirects
NEXT_PUBLIC_APP_URL="http://localhost:3000"
