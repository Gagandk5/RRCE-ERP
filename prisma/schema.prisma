datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PRINCIPAL
  ADMISSIONS
  HOD
  FACULTY
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  @@map("DailyAttendanceStatus")
}

enum SessionAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  @@map("AttendanceStatus")
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

enum AssignmentType {
  THEORY_ASSIGNMENT
  PRACTICAL_RECORD
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  OVERDUE
}

model Department {
  id                 String              @id @default(uuid())
  code               String              @unique // e.g. "BCA", "CSE", "AIML"
  name               String              // e.g. "Bachelor of Computer Applications"
  usnCode            String              @unique // e.g. "BC", "CS", "AI"
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  users              User[]
  students           Student[]
  subjects           Subject[]
  attendanceSessions AttendanceSession[]
  timetableSlots     TimetableSlot[]
}

model User {
  id                     String             @id @default(uuid())
  email                  String             @unique
  username               String             @unique
  passwordHash           String
  role                   Role
  firstName              String
  lastName               String
  phone                  String?
  photoUrl               String?
  departmentId           String?
  department             Department?        @relation(fields: [departmentId], references: [id])
  isActive               Boolean            @default(true)
  isPasswordResetRequired Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  studentProfile         Student?
  facultySessions        AttendanceSession[]
  timetableSlots         TimetableSlot[]
  submissions            Submission[]
}

model Student {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  usn             String             @unique // e.g. "1RR25BC001"
  usnCollegeCode  String             @default("1RR")
  usnYear         String             @default("25")
  usnBranch       String             // e.g. "BC"
  usnSequence     Int                // e.g. 1
  dateOfBirth     DateTime
  currentSemester Int                @default(1)
  section         String             @default("A")
  quota           String             @default("KCET") // KCET, COMEDK, MANAGEMENT
  departmentId    String?
  department      Department?        @relation(fields: [departmentId], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  attendanceRecords        AttendanceRecord[]
  sessionAttendanceRecords SessionAttendanceRecord[]
  invoices          Invoice[]

  @@index([usnSequence])
  @@index([departmentId, currentSemester])
}

model Subject {
  id           String       @id @default(uuid())
  code         String
  name         String
  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  semester     Int
  section      String       @default("A")
  assignments  Assignment[]
  attendanceRecords AttendanceRecord[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([code, departmentId, semester, section])
  @@index([departmentId, semester, section])
}

model Assignment {
  id          String           @id @default(uuid())
  title       String
  description String
  type        AssignmentType
  dueDate     DateTime
  totalMarks  Int
  subjectId   String
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  submissions Submission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([subjectId, dueDate])
}

model Submission {
  id           String           @id @default(uuid())
  status       SubmissionStatus @default(PENDING)
  submittedAt  DateTime?
  fileUrl      String?
  textResponse String?
  marksAwarded Int?
  feedback     String?
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId, status])
}

model AttendanceSession {
  id               String             @id @default(uuid())
  subject          String
  facultyId        String
  faculty          User               @relation(fields: [facultyId], references: [id])
  departmentId     String
  department       Department         @relation(fields: [departmentId], references: [id])
  semester         Int
  section          String             @default("A")
  date             DateTime           @default(now())
  lockedAt         DateTime?          // Set explicitly or evaluated dynamically (24 hours after creation)
  isLockedOverride Boolean            @default(false)
  unlockedBy       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  records          SessionAttendanceRecord[]

  @@index([facultyId, date])
  @@index([departmentId, semester, section])
}

model SessionAttendanceRecord {
  id        String            @id @default(uuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    SessionAttendanceStatus @default(PRESENT)
  remarks   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])

  @@map("AttendanceRecord")
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, subjectId, date])
  @@index([subjectId, date])

  @@map("DailyAttendanceRecord")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique // e.g. "INV-2025-001"
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  totalAmount   Float         @default(85000)
  paidAmount    Float         @default(0)
  status        InvoiceStatus @default(PENDING)
  dueDate       DateTime?
  title         String        @default("Annual Tuition Fee 2025-26")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([studentId])
}

model TimetableSlot {
  id           String     @id @default(uuid())
  dayOfWeek    String     // MON, TUE, WED, THU, FRI, SAT
  startTime    String     // e.g. "09:00"
  endTime      String     // e.g. "10:00"
  subject      String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  semester     Int
  section      String     @default("A")
  facultyId    String
  faculty      User       @relation(fields: [facultyId], references: [id])
  roomNumber   String     // e.g. "LH-101"
  academicYear String     @default("2025-2026")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([facultyId, dayOfWeek, startTime])
  @@index([roomNumber, dayOfWeek, startTime])
  @@index([departmentId, semester, section, dayOfWeek, startTime])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // e.g. "BRANCH_REALLOCATION", "ATTENDANCE_OVERRIDE", "FEE_PAYMENT"
  performedBy String   // Username or user ID
  details     String   // JSON stringified details
  timestamp   DateTime @default(now())

  @@index([timestamp])
  @@index([performedBy])
}
